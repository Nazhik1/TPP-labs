<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Новый" Click="NewFile_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Открыть..." Click="OpenFile_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Сохранить" Click="SaveFile_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Сохранить как..." Click="SaveAsFile_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <TextBox x:Name="MainTextBox"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 TextChanged="MainTextBox_TextChanged"/>
    </DockPanel>
</Window>
