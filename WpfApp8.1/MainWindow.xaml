<Window x:Class="WpfApp8._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WpfApp8._1.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}"
        Height="700" Width="1200">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="New"/>
        <KeyBinding Key="O" Modifiers="Control" Command="Open"/>
        <KeyBinding Key="S" Modifiers="Control" Command="Save"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FileMenu]}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NewMenuItem]}"
                          Click="NewFile_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OpenMenuItem]}"
                          Click="OpenFile_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SaveMenuItem]}"
                          Click="SaveFile_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SaveAsMenuItem]}"
                          Click="SaveAsFile_Click"/>
                <Separator/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ExitMenuItem]}"
                          Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LanguageMenu]}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RussianMenuItem]}"
                          Click="SetRussian_Click"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[EnglishMenuItem]}"
                          Click="SetEnglish_Click"/>
            </MenuItem>
        </Menu>

        <TextBox x:Name="MainTextBox"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 TextChanged="MainTextBox_TextChanged"/>
    </DockPanel>
</Window>